---
import '../styles/global.css';
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/ui/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import {
  DESCRIPCION_DEFECTO,
  DIRECCION,
  EMAIL,
  EMPRESA,
  REDES,
  WHATSAPP_NUMERO,
  linkWhatsApp,
} from '../consts';
import logoImg from '../assets/images/logo.png';

interface Props {
  title: string;
  description?: string;
  /** Ruta de la imagen para la preview de WhatsApp/Facebook. Absoluta o del build. */
  image?: string;
}

const {
  title,
  description = DESCRIPCION_DEFECTO,
  // Preview al compartir en WhatsApp/Facebook. Foto de cosecha (1200x630 JPG),
  // mucho más atractiva que el logo. Las páginas de producto pasan su propia imagen.
  image = '/og-image.jpg',
} = Astro.props;

// Astro.site viene de `site` en astro.config.mjs. Sin eso, esto caería a localhost
// y las previews al compartir el link saldrían rotas.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const whatsappHref = linkWhatsApp(
  'Hola, quisiera más información sobre sus productos.'
);

// Datos estructurados (JSON-LD) para Google. Le dice que somos un negocio real
// en Lima con teléfono, horario y redes, para aparecer en Google Maps y en la
// búsqueda local. Se emite en TODAS las páginas desde el <head>.
const negocioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#negocio', Astro.site).href,
  name: EMPRESA.nombre,
  legalName: EMPRESA.razonSocial,
  url: Astro.site?.href,
  logo: new URL(logoImg.src, Astro.site).href,
  image: new URL('/og-image.jpg', Astro.site).href,
  email: EMAIL,
  telephone: `+${WHATSAPP_NUMERO}`,
  foundingDate: String(EMPRESA.fundacion),
  taxID: EMPRESA.ruc,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: DIRECCION.zona,
    addressLocality: DIRECCION.distrito,
    addressRegion: DIRECCION.ciudad,
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'Country', name: 'Perú' },
    { '@type': 'Country', name: 'Bolivia' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
    ],
    opens: '08:00',
    closes: '18:00',
  },
  sameAs: [REDES.facebook, REDES.instagram, REDES.tiktok],
};
---

<!doctype html>
<html lang="es-PE" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#778E46" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={EMPRESA.nombre} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(negocioJsonLd)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;900&display=swap"
      rel="stylesheet"
      fetchpriority="high"
    >

    <ClientRouter />
  </head>
  <body class="font-sans antialiased text-gray-900 bg-white">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-brand-dark focus:px-6 focus:py-3 focus:rounded-full focus:font-bold focus:shadow-2xl"
    >
      Saltar al contenido
    </a>

    <Navbar />

    <main id="contenido">
      <slot />
    </main>

    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#20ba5a] text-white p-4 rounded-full shadow-2xl transition-all hover:scale-110 flex items-center justify-center group"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>

    <Footer />
  </body>
</html>
