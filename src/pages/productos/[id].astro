---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { EMPRESA, linkWhatsApp } from '../../consts';

export async function getStaticPaths() {
  const products = await getCollection('productos');
  return products.map((product) => ({
    params: { id: product.slug },
    props: { product },
  }));
}

type Props = {
  product: CollectionEntry<'productos'>;
};

const { product } = Astro.props;
const { nombre, titulo, imagen, fichaTecnica, resumen, pdf } = product.data;

// `imagen` ya viene validada y optimizada por el schema (helper image()).
// Se acabó el mapeo manual slug -> import que había que tocar a mano
// cada vez que se agregaba un producto.
const analisis = fichaTecnica?.analisisGarantizado;

// Fondo tenue de la página, específico por cultivo (fotos propias de Luyasa).
// Premium Nutrimix queda con el fondo neutro hasta tener una foto de cítricos.
const fondosPorProducto: Record<string, string> = {
  "cosecha-verde": "/images/clientes/cosecha-palta.jpeg",   // palta
  "isla-max": "/images/clientes/campo-papa.jpeg",           // hortalizas / papa
};
const fondoPagina = fondosPorProducto[product.slug] ?? "/images/fondo-cultivos.jpg";

// Nombre legible de cada fila del análisis: "materiaOrganica" -> "Materia Organica"
const etiquetaNutriente = (clave: string) =>
  clave.replace(/([A-Z])/g, ' $1').replace(/^./, (c) => c.toUpperCase());

const certificados = [
  { src: '/images/certificado-1.png', alt: 'Certificación Kiwa BCS Öko-Garantie' },
  { src: '/images/certificado-2.jpg', alt: 'Registro SENASA' },
  { src: '/images/certificado-3.jpg', alt: 'Análisis de laboratorio UNALM' },
  { src: '/images/certificado-4.svg', alt: 'Producto 100% orgánico' },
];

// Datos estructurados de Producto para Google (Rich Results). Incluye el
// análisis NPK como propiedades. Sin precio a propósito: la venta es por
// cotización, y un precio inventado daría un dato falso a Google.
const productoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  description: resumen,
  image: new URL(imagen.src, Astro.site).href,
  brand: { '@type': 'Brand', name: EMPRESA.nombreCorto },
  category: 'Abono orgánico',
  ...(analisis && {
    additionalProperty: Object.entries(analisis).map(([clave, valor]) => ({
      '@type': 'PropertyValue',
      name: etiquetaNutriente(clave),
      value: valor,
    })),
  }),
};
---

<Layout
  title={`${nombre} | Agronegocios Luyasa`}
  description={resumen}
  image={imagen.src}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productoJsonLd)}
  />

  <div class="relative w-full min-h-screen pt-32 pb-20">

    <div class="fixed inset-0 z-0 h-full w-full pointer-events-none">
        <img
            src={fondoPagina}
            alt=""
            aria-hidden="true"
            class="w-full h-full object-cover opacity-60"
        />
        <div class="absolute inset-0 bg-white/70"></div>
    </div>

    <section class="relative z-10 max-w-7xl mx-auto px-4 mb-20">

      <a href="/productos" class="inline-flex items-center gap-2 text-gray-700 hover:text-brand-green font-bold mb-8 transition-colors uppercase text-xs tracking-widest bg-white/80 px-4 py-2 rounded-full backdrop-blur-md shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Volver al Catálogo
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div class="relative group">
            <div class="absolute inset-0 bg-brand-green/20 rounded-full scale-90 blur-3xl"></div>
            <Image
              src={imagen}
              alt={nombre}
              width={800}
              quality="high"
              class="relative w-full max-w-md mx-auto drop-shadow-2xl transform transition-transform duration-500 group-hover:scale-105"
              transition:name={`image-${product.slug}`}
              loading="eager"
            />
        </div>

        <div class="bg-white/80 backdrop-blur-sm p-8 rounded-3xl shadow-xl border border-white/50">
          <span class="inline-block bg-brand-sun text-white text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-4 shadow-sm">
            Ficha Técnica
          </span>

          <h1 class="text-4xl md:text-6xl font-black text-brand-dark uppercase italic leading-none mb-6 drop-shadow-sm">
            {nombre}
          </h1>

          <p class="text-xl text-gray-800 font-medium leading-relaxed mb-8 border-l-4 border-brand-green pl-6">
            {resumen}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href={linkWhatsApp(`Hola, quisiera cotizar ${titulo}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-green-700 text-white px-8 py-4 rounded-full font-black hover:bg-brand-dark transition-all shadow-lg uppercase tracking-wider text-center flex items-center justify-center gap-2"
            >
              Cotizar Ahora
            </a>

            {pdf && (
              <a href={pdf} target="_blank" rel="noopener noreferrer" download class="bg-white text-brand-dark border-2 border-brand-dark px-8 py-4 rounded-full font-bold hover:bg-brand-dark hover:text-white transition-all uppercase text-center">
                Ficha PDF
              </a>
            )}
          </div>

          <div class="mt-8 border-t border-gray-100 pt-6">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">
              Calidad Certificada
            </p>
            <div class="flex flex-wrap items-center gap-6">
              {certificados.map((c) => (
                <img src={c.src} alt={c.alt} loading="lazy" decoding="async" class="h-12 w-auto object-contain opacity-80" />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {fichaTecnica && (
    <section class="relative z-10 max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {/* Sin este guard, un producto sin analisisGarantizado tumbaba el build entero. */}
            {analisis && (
              <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-lg border border-white/50">
                  <h2 class="text-2xl font-black text-brand-dark uppercase italic mb-8">🧪 Análisis Garantizado</h2>
                  <div class="space-y-4">
                      {Object.entries(analisis).map(([clave, valor]) => (
                          <div class="flex items-center justify-between border-b border-gray-100 pb-3 gap-4">
                              <span class="font-bold text-gray-500 uppercase text-sm">{etiquetaNutriente(clave)}</span>
                              <span class="font-black text-brand-dark text-lg text-right">{valor}</span>
                          </div>
                      ))}
                  </div>
              </div>
            )}

            <div class="space-y-8">
                {fichaTecnica.beneficios && fichaTecnica.beneficios.length > 0 && (
                  <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-lg border-l-8 border-brand-sun">
                      <h2 class="text-2xl font-black text-brand-dark uppercase italic mb-6">Beneficios Clave</h2>
                      <ul class="space-y-4">
                          {fichaTecnica.beneficios.map((b) => (
                              <li class="flex items-start gap-3">
                                  <span class="text-brand-green font-bold" aria-hidden="true">✓</span>
                                  <span class="font-bold text-gray-700">{b}</span>
                              </li>
                          ))}
                      </ul>
                  </div>
                )}

                {fichaTecnica.aplicacion && (
                  <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-lg border border-brand-green/20">
                      <h2 class="text-xl font-black text-brand-dark uppercase italic mb-4">Modo de Aplicación</h2>
                      <p class="text-gray-700 font-medium">{fichaTecnica.aplicacion}</p>
                  </div>
                )}

                {fichaTecnica.presentacion && (
                  <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-lg border border-brand-earth/20">
                      <h2 class="text-xl font-black text-brand-dark uppercase italic mb-4">Presentación</h2>
                      <p class="text-gray-700 font-medium">{fichaTecnica.presentacion}</p>
                  </div>
                )}
            </div>
        </div>
    </section>
    )}
  </div>
</Layout>
