---
import { EMPRESA } from '../../consts';

interface Props {
  title: string;
  subtitle?: string;
  bgImage?: string;
}

const {
  title,
  subtitle = EMPRESA.nombre,
  // Imagen propia y local: no dependemos de Unsplash ni de una petición externa.
  bgImage = "/images/fondo-cultivos.jpg"
} = Astro.props;
---

<header class="relative h-[50vh] min-h-100 flex items-center justify-center overflow-hidden">
  
  <div class="absolute inset-0 z-0">
    <!-- Imagen decorativa: el texto real está en el <h1> de abajo. -->
    <img
      src={bgImage}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-brand-dark/70"></div>
  </div>

  <div class="relative z-10 text-center px-4 mt-20">
    <span class="block text-brand-sun font-bold uppercase tracking-[0.3em] text-sm mb-4 animate-fade-in">
      {subtitle}
    </span>
    <h1 class="text-5xl md:text-6xl font-black text-white uppercase italic drop-shadow-2xl">
      {title}
    </h1>
    <div class="w-24 h-1 bg-brand-green mx-auto mt-6 rounded-full"></div>
  </div>
</header>