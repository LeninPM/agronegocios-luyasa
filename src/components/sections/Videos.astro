---
import { REDES } from '../../consts';

const videos = [
  { id: '7642011591986220305', titulo: 'Resultados en campo con abonos Luyasa' },
  { id: '7657239005150416135', titulo: 'Testimonios de nuestros clientes' },
  { id: '7641326299239288082', titulo: 'Cultivos que rinden con Luyasa' },
];
---
<section id="videos-section" class="py-20 bg-gray-50 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 text-center mb-12">
    <span class="text-brand-green font-bold uppercase tracking-widest text-sm mb-4 block">
      Síguenos en TikTok
    </span>
    <h2 class="text-4xl font-black text-brand-dark uppercase italic mb-4">
      Resultados en Campo
    </h2>
    <p class="text-gray-600 text-lg max-w-2xl mx-auto font-medium">
      Mira cómo nuestros clientes transforman sus cultivos. Evidencia real en campo.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    {videos.map((video) => (
      <div class="bg-white rounded-3xl shadow-lg overflow-hidden border border-gray-100 flex justify-center p-2 min-h-[500px]">
        <blockquote
          class="tiktok-embed"
          cite={`${REDES.tiktok}/video/${video.id}`}
          data-video-id={video.id}
          data-titulo={video.titulo}
          style="max-width: 605px; min-width: 325px;"
        >
          <section>
            <div class="flex flex-col items-center justify-center h-full text-gray-400 gap-2 py-24">
              <div class="w-8 h-8 border-4 border-gray-200 border-t-brand-green rounded-full animate-spin"></div>
              <p class="text-sm font-bold">Cargando video…</p>
              <a
                href={`${REDES.tiktok}/video/${video.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs underline text-brand-green"
              >
                Ver "{video.titulo}" en TikTok
              </a>
            </div>
          </section>
        </blockquote>
      </div>
    ))}
  </div>

  <div class="text-center mt-12">
    <a
      href={REDES.tiktok}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 bg-black text-white px-8 py-4 rounded-full font-black hover:bg-gray-800 transition-all transform hover:-translate-y-1 shadow-xl uppercase tracking-wider text-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 448 512" aria-hidden="true"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/></svg>
      Ver más videos en TikTok
    </a>
  </div>
</section>

<script>
  const SCRIPT_TIKTOK = 'https://www.tiktok.com/embed.js';

  /**
   * Pone un `title` a los iframes que inyecta TikTok (los crea sin él, y sin
   * title son inaccesibles para lectores de pantalla). Antes esto se hacía con
   * un setInterval cada 2s durante 15s; un MutationObserver reacciona al
   * instante y se apaga solo.
   */
  function observarIframes(seccion: HTMLElement) {
    const titular = () => {
      seccion.querySelectorAll('blockquote.tiktok-embed').forEach((bq) => {
        const iframe = bq.querySelector('iframe');
        if (iframe && !iframe.getAttribute('title')) {
          iframe.setAttribute(
            'title',
            bq.getAttribute('data-titulo') ?? 'Video de Agronegocios Luyasa en TikTok'
          );
        }
      });
    };

    const observer = new MutationObserver(titular);
    observer.observe(seccion, { childList: true, subtree: true });
    titular();

    // Los embeds nunca tardan tanto; a los 30s dejamos de escuchar.
    setTimeout(() => observer.disconnect(), 30000);
    return observer;
  }

  function initVideos() {
    const seccion = document.getElementById('videos-section');
    if (!seccion) return;

    // Carga diferida: el script de TikTok solo baja cuando el usuario
    // llega a la sección, no en el primer pintado.
    const io = new IntersectionObserver(
      (entradas) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        io.disconnect();

        // Se re-inyecta en cada visita porque embed.js solo escanea el DOM al
        // ejecutarse: si volvieras a la home con el ClientRouter, los
        // blockquotes nuevos se quedarían sin renderizar.
        document
          .querySelectorAll(`script[src="${SCRIPT_TIKTOK}"]`)
          .forEach((s) => s.remove());

        const script = document.createElement('script');
        script.src = SCRIPT_TIKTOK;
        script.async = true;
        document.body.appendChild(script);

        observarIframes(seccion);
      },
      { rootMargin: '200px' }
    );

    io.observe(seccion);
  }

  // Se dispara en la carga inicial y tras cada navegación del ClientRouter.
  document.addEventListener('astro:page-load', initVideos);
</script>
